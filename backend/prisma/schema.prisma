generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATTENDANT
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(ATTENDANT)
  active       Boolean        @default(true)
  /// Tokens emitidos antes desta data deixam de valer (troca ou redefinição de senha)
  passwordChangedAt DateTime?
  createdAt    DateTime       @default(now())
  orders       ServiceOrder[]
  events       StatusEvent[]
  invoices     OrderInvoice[]
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  document  String?
  /// Somente dígitos do CPF/CNPJ (usado no acesso do cliente por documento)
  documentDigits String?
  phone     String?
  email     String?
  notes     String?
  /// Dados pessoais removidos a pedido do titular (LGPD); o histórico de OS é mantido
  anonymizedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
  access    CustomerAccess?

  @@index([name])
  @@index([documentDigits])
}

model Vehicle {
  id         String         @id @default(uuid())
  plate      String         @unique
  brand      String
  model      String
  year       Int?
  color      String?
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orders     ServiceOrder[]

  @@index([customerId])
}

model ServiceOrder {
  id          String        @id @default(uuid())
  number      Int           @unique @default(autoincrement())
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  status      OrderStatus   @default(OPEN)
  description String
  mileageIn   Int?
  openedAt    DateTime      @default(now())
  closedAt    DateTime?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       ServiceItem[]
  events      StatusEvent[]
  invoice     OrderInvoice?

  // Acompanhamento pelo cliente (link público somente leitura)
  publicToken          String?   @unique
  publicTokenExpiresAt DateTime?

  @@index([vehicleId])
  @@index([status])
}

model ServiceItem {
  id          String       @id @default(uuid())
  orderId     String
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  notes       String?
  performedAt DateTime     @default(now())

  @@index([orderId])
}

/// Linha do tempo da OS: cada mudança de status é registrada (quem e quando).
model StatusEvent {
  id          String       @id @default(uuid())
  orderId     String
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  createdAt   DateTime     @default(now())
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

/// Código de acesso (PIN) do cliente à área do cliente. Guardado apenas como hash.
model CustomerAccess {
  customerId     String    @id
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pinHash        String
  /// Sessões iniciadas antes desta data deixam de valer (novo código gerado)
  pinIssuedAt    DateTime  @default(now())
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Nota fiscal (PDF) anexada pelos funcionários quando a OS fica pronta.
/// Armazenada no próprio banco (bytea) por simplicidade; em escala, migrar o conteúdo para um storage de objetos.
model OrderInvoice {
  id           String       @id @default(uuid())
  orderId      String       @unique
  order        ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String       @default("application/pdf")
  sizeBytes    Int
  content      Bytes
  uploadedAt   DateTime     @default(now())
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
}
